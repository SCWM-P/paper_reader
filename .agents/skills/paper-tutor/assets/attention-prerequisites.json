        "concepts": [
          {
            "id": "weighted-average",
            "term": "加权平均（weighted average）",
            "state": "explained",
            "depends_on": [],
            "lesson": [
              {
                "kind": "teaching",
                "title": "按比例合成两个数",
                "text": "普通平均给每个数相同份额；加权平均给每个数指定份额。10 与 20 各占一半，结果是 0.5×10 + 0.5×20 = 15；若 20 占四分之三，结果是 0.25×10 + 0.75×20 = 17.5。份额加起来为 1。"
              },
              {
                "kind": "background",
                "title": "定义与限制",
                "text": "一般加权平均等于“各数乘权重后的总和”除以“权重总和”。本例选非负、总和为 1 的权重，所以可直接相加；使用负权重时不一定落在原数之间。",
                "locator": "NumPy average 文档 · avg = sum(a * weights) / sum(weights)",
                "url": "https://numpy.org/doc/stable/reference/generated/numpy.average.html"
              }
            ],
            "check": {
              "question": "10 占 20%，20 占 80%，结果是多少？可跳过。",
              "reference_answer": "0.2×10 + 0.8×20 = 18。结果更靠近份额较大的 20。",
              "assessment": "pending"
            }
          },
          {
            "id": "dot-product",
            "term": "点积（dot product）",
            "state": "explained",
            "depends_on": [],
            "lesson": [
              {
                "kind": "teaching",
                "title": "把两串数字变成一个分数",
                "text": "向量就是一串有顺序的数字。点积把对应位置相乘再相加：q=(1,0)，k=(0,1) 时，分数为 1×0 + 0×1 = 0；k=(1,0) 时为 1×1 + 0×0 = 1。它在这里提供匹配分数。接下来的完整算例只用一个位置，点积就是乘法。"
              },
              {
                "kind": "inference",
                "title": "“匹配”是当前模型中的用途",
                "text": "点积大小取决于输入数字与尺度，不能普遍等同于语义相似度。这里用手工数字说明计算，真实模型中的表示由训练获得。"
              }
            ],
            "check": {
              "question": "(1,2) 与 (3,0) 的点积是多少？可跳过。",
              "reference_answer": "1×3 + 2×0 = 3。两串各有两个数字，输出一个分数。",
              "assessment": "pending"
            }
          },
          {
            "id": "attention",
            "term": "从分数到注意力输出",
            "state": "explained",
            "depends_on": [
              "weighted-average",
              "dot-product"
            ],
            "lesson": [
              {
                "kind": "teaching",
                "title": "一个位置、两个信息项",
                "text": "设查询 q=1，两个键 k₁=0、k₂=1，两个待合成值 v₁=10、v₂=20。查询表示当前取信息的条件，键用于计算匹配分数，值是被合成的内容。每个键只有一个数字，故 dₖ=1、√dₖ=1；缩放后的分数为 0、1。"
              },
              {
                "kind": "teaching",
                "title": "softmax 把分数变成份额",
                "text": "softmax 先把分数 s 换成正数 eˢ，再除以这些正数的总和。e 是约等于 2.71828 的固定数；本例只需要 e⁰=1、e¹≈2.71828。两个份额为 1/(1+2.71828)≈0.268941 与 2.71828/(1+2.71828)≈0.731059，总和为 1。输出为 0.268941×10 + 0.731059×20≈17.310586。"
              },
              {
                "kind": "paper",
                "title": "代回论文式 (1)",
                "text": "论文将多个查询、键、值排成矩阵，写为 \\(\\operatorname{Attention}(Q,K,V)=\\operatorname{softmax}(QK^{\\mathsf T}/\\sqrt{d_k})V\\)。依次对应：点积评分 → 缩放 → 转成份额 → 加权合成。上述数字是教学构造，不是论文实验结果。",
                "locator": "§3.2.1，Equation (1)，PDF 物理页 4",
                "url": "https://papers.nips.cc/paper_files/paper/2017/file/3f5ee243547dee91fbd053c1c4a845aa-Paper.pdf#page=4"
              },
              {
                "kind": "inference",
                "title": "当前读到哪里就够用",
                "text": "本例只解释单个查询的计算，不覆盖多头投影、训练、mask 或指数函数的一般性质。若后续卡在这些内容，分别建立下一条卡点。"
              }
            ],
